{
  "name": "@payops/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup src/main.ts --format esm --target node22 --out-dir dist --clean --no-splitting --noExternal @payops/shared --noExternal @payops/core --noExternal @payops/simulator",
    "typecheck": "tsc -p tsconfig.json",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@payops/core": "workspace:*",
    "@payops/shared": "workspace:*",
    "@payops/simulator": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "pg-boss": "^12.0.0",
    "pino-http": "^10.5.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0"
  }
}