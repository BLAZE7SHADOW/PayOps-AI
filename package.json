{
  "name": "payops-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm --filter @payops/server dev\" \"pnpm --filter @payops/web dev\"",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "tsx scripts/local-db.ts",
    "db:migrate": "pnpm --filter @payops/core db:migrate",
    "db:generate": "pnpm --filter @payops/core db:generate",
    "seed": "pnpm --filter @payops/server seed",
    "jev:ping": "tsx scripts/jev-ping.ts",
    "cassette:record": "tsx packages/agents/scripts/record-cassettes.ts",
    "eval": "tsx packages/evals/scripts/run-eval.ts",
    "eval:live": "tsx packages/evals/scripts/run-eval.ts --mode=live"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11"
  }
}
