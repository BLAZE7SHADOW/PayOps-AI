# Copy to .env and fill values. Never commit .env.

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000

# Supabase: Project Settings > Database > Session pooler (port 5432). Local: pnpm db:local
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
# Optional. Leave empty to use the fixed development secret. If set, use 16 or more characters.
# Required in production.
JWT_SECRET=

# LIVE | RECORD | REPLAY
AI_MODE=REPLAY
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=

TYPESAFE_JEV_API_KEY=
JEV_MODEL=jev-1.13.0

# simulator | razorpay
GATEWAY_ADAPTER=simulator
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# How often job queue workers check Postgres for work, in seconds (default 2, minimum 0.5).
JOB_POLL_SECONDS=
# Agent runtime: ts (in this process, default) or python (the service in python/agents, D085)
AGENT_RUNTIME=
AGENT_SERVICE_URL=
AGENT_INTERNAL_SECRET=
